# Network RPC URLs
# Get free RPC URLs from Alchemy (https://alchemy.com) or Infura (https://infura.io)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Deployer Private Key (without 0x prefix)
# ⚠️ NEVER commit your real private key! Use a dedicated deployment wallet.
PRIVATE_KEY=your_private_key_here

# Etherscan API Key (for contract verification)
# Get yours at https://etherscan.io/apis
ETHERSCAN_API_KEY=your_etherscan_api_key

# Optional: For gas reporting
REPORT_GAS=true
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key
